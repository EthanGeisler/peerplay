{
  "name": "@boilerdeck/client",
  "version": "0.3.0",
  "description": "BoilerDeck desktop client — decentralized game distribution powered by BitTorrent",
  "author": "BoilerDeck <dev@boilerdeck.com>",
  "private": true,
  "main": "dist/main/index.js",
  "scripts": {
    "dev": "vite",
    "dev:electron": "electron .",
    "build": "vite build && tsc -p tsconfig.main.json",
    "build:electron": "vite build && tsc -p tsconfig.main.json",
    "pack": "npm run build:electron && electron-builder --dir",
    "dist": "npm run build:electron && electron-builder",
    "preview": "vite preview",
    "test:e2e": "npx playwright test"
  },
  "dependencies": {
    "@boilerdeck/ui-shared": "*",
    "@noble/curves": "^2.0.0",
    "@noble/hashes": "^2.0.1",
    "@scure/base": "^2.0.0",
    "@scure/bip32": "^2.0.1",
    "@scure/bip39": "^2.0.1",
    "electron-updater": "^6.3.0",
    "react": "^19.1.0",
    "react-dom": "^19.1.0",
    "react-router-dom": "^7.6.0",
    "socks-proxy-agent": "^9.0.0",
    "webtorrent": "^2.5.0",
    "ws": "^8.19.0",
    "zustand": "^5.0.0"
  },
  "devDependencies": {
    "@playwright/test": "^1.58.2",
    "@types/react": "^19.1.0",
    "@types/react-dom": "^19.1.0",
    "@types/ws": "^8.18.1",
    "@vitejs/plugin-react": "^4.4.0",
    "electron": "^35.0.0",
    "electron-builder": "^25.1.0",
    "typescript": "^5.7.0",
    "vite": "^6.3.0"
  },
  "build": {
    "appId": "com.boilerdeck.client",
    "productName": "BoilerDeck",
    "electronVersion": "35.7.5",
    "npmRebuild": false,
    "directories": {
      "output": "release"
    },
    "files": [
      "dist/**/*",
      "node_modules/**/*",
      "!node_modules/@boilerdeck/**",
      "package.json"
    ],
    "extraResources": [
      {
        "from": "resources/tor/",
        "to": "tor/",
        "filter": ["**/*", "!.gitkeep", "!README.md"]
      }
    ],
    "asar": true,
    "asarUnpack": [
      "node_modules/webtorrent/**",
      "node_modules/utp-native/**",
      "node_modules/**/*.node"
    ],
    "win": {
      "target": [
        "nsis",
        "portable"
      ],
      "icon": "resources/icon.ico",
      "signAndEditExecutable": false
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true
    },
    "publish": [
      {
        "provider": "github",
        "owner": "EthanGeisler",
        "repo": "peerplay"
      }
    ]
  }
}
