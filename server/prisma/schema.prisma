generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum UserRole {
  PLAYER
  DEVELOPER
  ADMIN
}

enum ListingStatus {
  DRAFT
  PENDING_REVIEW
  PUBLISHED
  SUSPENDED
  @@map("GameStatus")
}

enum ContentType {
  GAME
  VIDEO
  SOFTWARE
  AUDIO
  OTHER
  @@map("content_type")
}

enum VersionStatus {
  PROCESSING
  READY
  FAILED
}

enum LicenseStatus {
  ACTIVE
  REVOKED
  REFUNDED
}

enum PaymentStatus {
  PENDING
  COMPLETED
  FAILED
  REFUNDED
}

enum CustodyMode {
  CUSTODIAL
  SELF_CUSTODY
  @@map("custody_mode")
}

model User {
  id              String    @id @default(uuid())
  email           String?   @unique
  passwordHash    String?   @map("password_hash")
  displayName     String    @map("display_name")
  role            UserRole  @default(PLAYER)
  stripeCustomerId  String?      @map("stripe_customer_id")
  nostrPubkey       String?      @unique @map("nostr_pubkey")
  encryptedNsec     String?      @map("encrypted_nsec")
  encryptedMnemonic String?      @map("encrypted_mnemonic")
  custodyMode       CustodyMode  @default(CUSTODIAL) @map("custody_mode")
  createdAt       DateTime  @default(now()) @map("created_at")
  updatedAt       DateTime  @updatedAt @map("updated_at")

  developer       Developer?
  licenses        License[]
  payments        Payment[]
  saveFiles       SaveFile[]
  refreshTokens   RefreshToken[]

  @@map("users")
}

model RefreshToken {
  id        String   @id @default(uuid())
  userId    String   @map("user_id")
  token     String   @unique
  expiresAt DateTime @map("expires_at")
  createdAt DateTime @default(now()) @map("created_at")

  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("refresh_tokens")
}

model Developer {
  id              String   @id @default(uuid())
  userId          String   @unique @map("user_id")
  studioName      String   @map("studio_name")
  stripeAccountId      String?  @map("stripe_account_id")
  stripeOnboarded      Boolean  @default(false) @map("stripe_onboarded")
  stripePayoutsEnabled Boolean  @default(false) @map("stripe_payouts_enabled")
  createdAt            DateTime @default(now()) @map("created_at")
  updatedAt       DateTime @updatedAt @map("updated_at")

  user            User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  listings        Listing[]

  @@map("developers")
}

model Listing {
  id          String        @id @default(uuid())
  developerId String        @map("developer_id")
  slug        String        @unique
  title       String
  description String        @default("")
  priceCents  Int           @map("price_cents")
  status      ListingStatus @default(DRAFT)
  exePath     String?       @map("exe_path")
  savePaths   String[]      @default([]) @map("save_paths")
  coverImageUrl String?     @map("cover_image_url")
  screenshots String[]      @default([])
  contentType ContentType   @default(GAME) @map("content_type")
  metadata    Json          @default("{}")
  eventId     String?       @unique @map("event_id")
  createdAt   DateTime      @default(now()) @map("created_at")
  updatedAt   DateTime      @updatedAt @map("updated_at")

  developer   Developer     @relation(fields: [developerId], references: [id], onDelete: Cascade)
  event       Event?        @relation(fields: [eventId], references: [id])
  versions    ListingVersion[]
  licenses    License[]
  payments    Payment[]
  saveFiles   SaveFile[]

  @@map("games")
}

model ListingVersion {
  id            String        @id @default(uuid())
  gameId        String        @map("game_id")
  version       String
  torrentId     String?       @unique @map("torrent_id")
  fileSizeBytes BigInt        @default(0) @map("file_size_bytes")
  status        VersionStatus @default(PROCESSING)
  changelog     String        @default("")
  createdAt     DateTime      @default(now()) @map("created_at")

  listing       Listing       @relation(fields: [gameId], references: [id], onDelete: Cascade)
  torrent       Torrent?      @relation(fields: [torrentId], references: [id])

  @@unique([gameId, version])
  @@map("game_versions")
}

model Torrent {
  id              String       @id @default(uuid())
  infoHash        String       @unique @map("info_hash")
  magnetUri       String       @map("magnet_uri")
  torrentFile     Bytes        @map("torrent_file")
  createdAt       DateTime     @default(now()) @map("created_at")

  version         ListingVersion?

  @@map("torrents")
}

model License {
  id                String        @id @default(uuid())
  userId            String        @map("user_id")
  gameId            String        @map("game_id")
  paymentId         String?       @unique @map("payment_id")
  status            LicenseStatus @default(ACTIVE)
  createdAt         DateTime      @default(now()) @map("created_at")
  updatedAt         DateTime      @updatedAt @map("updated_at")

  user              User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  listing           Listing       @relation(fields: [gameId], references: [id], onDelete: Cascade)
  payment           Payment?      @relation(fields: [paymentId], references: [id])

  @@unique([userId, gameId])
  @@map("licenses")
}

model Payment {
  id                    String        @id @default(uuid())
  userId                String        @map("user_id")
  gameId                String        @map("game_id")
  stripePaymentIntentId   String?       @unique @map("stripe_payment_intent_id")
  stripeCheckoutSessionId String?       @unique @map("stripe_checkout_session_id")
  amountCents             Int           @map("amount_cents")
  platformFeeCents      Int           @map("platform_fee_cents")
  status                PaymentStatus @default(PENDING)
  createdAt             DateTime      @default(now()) @map("created_at")
  updatedAt             DateTime      @updatedAt @map("updated_at")

  user                  User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  listing               Listing       @relation(fields: [gameId], references: [id], onDelete: Cascade)
  license               License?

  @@map("payments")
}

model Event {
  id         String   @id                          // SHA-256 hash of canonical JSON (NIP-01)
  pubkey     String                                // 64-char hex, x-only secp256k1 pubkey
  createdAt  Int      @map("created_at_unix")      // Unix timestamp (seconds)
  kind       Int                                   // Event kind (30001=listing, 30002=version, etc.)
  tags       Json                                  // Array of string arrays (NIP-01)
  content    String                                // Event content (often JSON-stringified)
  sig        String                                // 128-char hex Schnorr signature
  dTag       String?  @map("d_tag")                // Parameterized replaceable event identifier
  receivedAt DateTime @default(now()) @map("received_at")

  listings   Listing[]

  @@unique([pubkey, kind, dTag])
  @@index([kind])
  @@index([pubkey])
  @@index([createdAt])
  @@index([kind, createdAt])
  @@map("events")
}

model SaveFile {
  id         String   @id @default(uuid())
  userId     String   @map("user_id")
  gameId     String   @map("game_id")
  slot       Int      @default(0)
  filePath   String   @map("file_path")
  b2Key      String   @map("b2_key")
  sha256Hash String   @map("sha256_hash")
  version    Int      @default(1)
  sizeBytes  BigInt   @default(0) @map("size_bytes")
  createdAt  DateTime @default(now()) @map("created_at")
  updatedAt  DateTime @updatedAt @map("updated_at")

  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  listing    Listing  @relation(fields: [gameId], references: [id], onDelete: Cascade)

  @@unique([userId, gameId, slot, filePath])
  @@map("save_files")
}
